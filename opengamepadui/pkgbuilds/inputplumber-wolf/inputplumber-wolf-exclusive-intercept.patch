+        if !self.passthrough || self.exclusive == exclusive {
+            return Ok(());
+        }
+
+        let result = if exclusive {
+            self.device.grab()
+        } else {
+            self.device.ungrab()
+        };
+        if let Err(err) = result {
+            return Err(format!("Failed to update evdev exclusive grab: {err}").into());
+        }
+
+        self.exclusive = exclusive;
+        log::info!(
+            "{} exclusive grab for passthrough gamepad",
+            if exclusive { "Enabled" } else { "Disabled" }
+        );
+        Ok(())
+    }
