--- a/core/systems/launcher/window_exit_policy.gd
+++ b/core/systems/launcher/window_exit_policy.gd
@@ -0,0 +1,29 @@
+extends RefCounted
+class_name WindowExitPolicy
+
+## Grace periods for launch commands whose Wine/launcher helpers outlive the
+## actual game window. Explicit menu stops can settle quickly; a spontaneously
+## missing window gets more time in case the game is recreating its swapchain.
+
+const STOPPING_GRACE_MSEC := 3000
+const MISSING_WINDOW_GRACE_MSEC := 8000
+
+
+static func grace_elapsed(started_at: int, now: int, grace_msec: int) -> bool:
+	if started_at <= 0 or now < started_at:
+		return false
+	return now - started_at >= grace_msec
+
+
+static func should_finalize_explicit_stop(started_at: int, now: int) -> bool:
+	return grace_elapsed(started_at, now, STOPPING_GRACE_MSEC)
+
+
+static func should_finalize_missing_window(
+		is_managed: bool,
+		started_at: int,
+		now: int,
+	) -> bool:
+	if not is_managed:
+		return false
+	return grace_elapsed(started_at, now, MISSING_WINDOW_GRACE_MSEC)
--- a/core/systems/launcher/window_exit_policy_test.gd
+++ b/core/systems/launcher/window_exit_policy_test.gd
@@ -0,0 +1,22 @@
+extends GutTest
+
+const ExitPolicy := preload("res://core/systems/launcher/window_exit_policy.gd")
+
+
+func test_waits_for_an_explicit_stop_to_settle() -> void:
+	assert_false(ExitPolicy.should_finalize_explicit_stop(1000, 3999))
+	assert_true(ExitPolicy.should_finalize_explicit_stop(1000, 4000))
+
+
+func test_waits_longer_for_a_spontaneously_missing_window() -> void:
+	assert_false(ExitPolicy.should_finalize_missing_window(true, 1000, 8999))
+	assert_true(ExitPolicy.should_finalize_missing_window(true, 1000, 9000))
+
+
+func test_does_not_finalize_an_unmanaged_external_app() -> void:
+	assert_false(ExitPolicy.should_finalize_missing_window(false, 1000, 20000))
+
+
+func test_requires_a_valid_transition_timestamp() -> void:
+	assert_false(ExitPolicy.should_finalize_explicit_stop(0, 20000))
+	assert_false(ExitPolicy.should_finalize_missing_window(true, 0, 20000))
