diff --git a/core/systems/launcher/gamescope_focusable_windows.gd b/core/systems/launcher/gamescope_focusable_windows.gd
new file mode 100644
index 0000000..b6aad8d
--- /dev/null
+++ b/core/systems/launcher/gamescope_focusable_windows.gd
@@ -0,0 +1,36 @@
+extends RefCounted
+class_name GamescopeFocusableWindows
+
+## Helpers for parsing GAMESCOPE_FOCUSABLE_WINDOWS.
+##
+## Gamescope publishes this root-window property as repeating
+## [window_id, app_id, pid] triplets. Keeping the parser independent from the
+## X11 client makes it possible to match windows even when an intermediary
+## launcher (Bottles, Heroic, Lutris, etc.) strips OGUI_ID from child processes.
+
+const ENTRY_SIZE := 3
+
+
+## Return candidate window IDs whose Gamescope app ID matches [param app_id].
+## Incomplete trailing entries are ignored.
+static func find_for_app(
+		entries: PackedInt64Array,
+		app_id: int,
+		candidate_windows: PackedInt64Array = PackedInt64Array(),
+	) -> PackedInt64Array:
+	var matching_windows := PackedInt64Array()
+	var complete_size := entries.size() - (entries.size() % ENTRY_SIZE)
+
+	for index in range(0, complete_size, ENTRY_SIZE):
+		var window_id := entries[index]
+		var entry_app_id := entries[index + 1]
+		if entry_app_id != app_id:
+			continue
+		if not candidate_windows.is_empty() and not window_id in candidate_windows:
+			continue
+		if window_id in matching_windows:
+			continue
+		matching_windows.append(window_id)
+
+	matching_windows.sort()
+	return matching_windows
diff --git a/core/systems/launcher/gamescope_focusable_windows_test.gd b/core/systems/launcher/gamescope_focusable_windows_test.gd
new file mode 100644
index 0000000..e5ef977
--- /dev/null
+++ b/core/systems/launcher/gamescope_focusable_windows_test.gd
@@ -0,0 +1,45 @@
+extends GutTest
+
+const FocusableWindows := preload("res://core/systems/launcher/gamescope_focusable_windows.gd")
+
+
+func test_finds_window_when_launcher_child_loses_ogui_id() -> void:
+	var entries := PackedInt64Array([33554433, 658226143, 1043])
+	var candidates := PackedInt64Array([33554433])
+
+	var actual := FocusableWindows.find_for_app(entries, 658226143, candidates)
+
+	assert_eq(actual, PackedInt64Array([33554433]))
+
+
+func test_finds_multiple_windows_for_the_same_app() -> void:
+	var entries := PackedInt64Array([
+		101, 5001, 201,
+		102, 5002, 202,
+		103, 5001, 203,
+	])
+
+	var actual := FocusableWindows.find_for_app(entries, 5001)
+
+	assert_eq(actual, PackedInt64Array([101, 103]))
+
+
+func test_rejects_non_candidate_and_other_app_windows() -> void:
+	var entries := PackedInt64Array([
+		101, 5001, 201,
+		102, 5001, 202,
+		103, 5002, 203,
+	])
+	var candidates := PackedInt64Array([102, 103])
+
+	var actual := FocusableWindows.find_for_app(entries, 5001, candidates)
+
+	assert_eq(actual, PackedInt64Array([102]))
+
+
+func test_ignores_incomplete_trailing_entry() -> void:
+	var entries := PackedInt64Array([101, 5001, 201, 102, 5001])
+
+	var actual := FocusableWindows.find_for_app(entries, 5001)
+
+	assert_eq(actual, PackedInt64Array([101]))
