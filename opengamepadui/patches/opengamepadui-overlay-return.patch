diff --git a/core/systems/gamescope/gamescope_session_state.gd b/core/systems/gamescope/gamescope_session_state.gd
new file mode 100644
--- /dev/null
+++ b/core/systems/gamescope/gamescope_session_state.gd
@@ -0,0 +1,22 @@
+extends RefCounted
+class_name GamescopeSessionState
+
+## Pure helpers for Gamescope state transitions around a launched game.
+
+const OVERLAY_DISABLED := 0
+const OVERLAY_ENABLED := 1
+
+
+## Return the STEAM_OVERLAY value for the given global game state.
+static func overlay_value(in_game: bool) -> int:
+	if in_game:
+		return OVERLAY_ENABLED
+	return OVERLAY_DISABLED
+
+
+## Return the idle baselayer list, without AppIDs from exited games.
+static func default_baselayer_apps(
+		extra_unknown_app_id: int,
+		overlay_app_id: int,
+	) -> PackedInt64Array:
+	return PackedInt64Array([extra_unknown_app_id, overlay_app_id])
diff --git a/core/systems/gamescope/gamescope_session_state_test.gd b/core/systems/gamescope/gamescope_session_state_test.gd
new file mode 100644
--- /dev/null
+++ b/core/systems/gamescope/gamescope_session_state_test.gd
@@ -0,0 +1,25 @@
+extends GutTest
+
+const SessionState := preload("res://core/systems/gamescope/gamescope_session_state.gd")
+
+
+func test_enables_overlay_while_game_is_running() -> void:
+	assert_eq(SessionState.overlay_value(true), 1)
+
+
+func test_disables_overlay_after_last_game_exits() -> void:
+	assert_eq(
+		SessionState.overlay_value(false),
+		0,
+		"The menu must become a normal Gamescope window again",
+	)
+
+
+func test_restores_idle_baselayer_apps_after_last_game_exits() -> void:
+	var actual := SessionState.default_baselayer_apps(413091, 769)
+
+	assert_eq(
+		actual,
+		PackedInt64Array([413091, 769]),
+		"Exited game AppIDs must not remain in the baselayer list",
+	)
